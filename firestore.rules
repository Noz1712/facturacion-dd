rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /invoices/{invoiceId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /clients/{clientId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /generatedInvoices/{invoiceId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /companyProfiles/{profileId} {
      allow create: if isOwner(request.resource.data.userId) && profileId == request.auth.uid;
      allow read, delete: if isOwner(resource.data.userId) && profileId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && profileId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
